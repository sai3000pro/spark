# Spark — environment
#
# Copy to .env.local and fill in. Everything here is optional for `npm run dev`:
# with none of it set the app runs exactly as it does today — public demo walks,
# no sign-in, in-memory stores, local filesystem for uploads. Each block below
# turns on one capability.
#
# NOTHING SECRET MAY CARRY THE `NEXT_PUBLIC_` PREFIX. That prefix inlines the
# value into the client bundle at build time, where it is world-readable. The
# split below is deliberate; do not "fix" a server variable by adding it.

# ── Supabase — Postgres, Auth, Realtime ──────────────────────────────────────
# The anon key is safe in the browser: it carries no authority of its own and
# every table is behind RLS. The service role key is the opposite — it bypasses
# RLS on every table. Server-only, and never returned in any API response.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 — the primary blob store ───────────────────────────────────
# Chosen over every other free tier because egress is free at any volume, and
# this app's job is handing 5-30 MB splats to browsers. 10 GB stored free.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_SPLATS=spark-splats
R2_BUCKET_UPLOADS=spark-uploads

# Where the CDN worker is published. Public delivery assets are served from a
# stable path here rather than as presigned URLs — a signature in the query
# string makes every URL a distinct cache key, so nothing would ever be cached.
NEXT_PUBLIC_CDN_URL=

# HMAC secret for private-asset URLs, minted only after can_read_journey passes.
ASSET_TOKEN_SECRET=

# ── Firebase — Realtime Database and Cloud Messaging only ────────────────────
# NOT Firebase Storage: since 2024-10-30 a new project cannot provision a bucket
# without a billing account, and since 2026-02-02 non-Blaze projects lost access
# to existing ones. It cannot contribute free blob capacity.
#
# What it does contribute, free and with no card: RTDB (1 GB stored, 10 GB/month
# egress, 100 simultaneous connections) for live job progress, which spares
# Supabase Realtime's budget entirely; and FCM for "your reconstruction is
# ready" push, which Supabase has no equivalent of at any tier.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# VAPID public key for web push. Public by design.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service account JSON, base64-encoded, for server-side RTDB writes and FCM sends.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── Local dev escape hatches ─────────────────────────────────────────────────
# Keeps the current .uploads/ + public/mock/splats filesystem path alive so the
# app works with no Supabase and no R2 configured.
RECON_LOCAL_FS=1

# ── Reconstruction Studio (optional, power user) ─────────────────────────────
# The local GPU box running Brush/COLMAP. These are dev defaults only; on a
# hosted deployment the studio URL is per-user runtime config, because
# `localhost` inside a serverless function is the function's own loopback.
NEXT_PUBLIC_STUDIO_URL=http://localhost:8899
NEXT_PUBLIC_VIEWER_URL=http://localhost:8765
# Set only if the studio is exposed through a tunnel and should be reachable
# server-side (for background polling). Server-only, deliberately un-prefixed.
STUDIO_URL=

# ── KIRI Engine (cloud reconstruction) ───────────────────────────────────────
# Put your key here and the "Send to KIRI" destination lights up on its own —
# no pasting it into the page each time the dev server restarts. It is checked
# against KIRI's own /balance before it is offered, so a dead or empty key shows
# as unavailable with the reason rather than failing after a 100 MB upload.
#
# SERVER-ONLY, and it must stay that way. Never rename this to NEXT_PUBLIC_*:
# that prefix inlines the value into the client bundle and publishes your key to
# every visitor. The key is never sent to the browser — /api/reconstruction/key
# returns four characters and a credit count, nothing more.
#
# Pasting a key in the UI overrides this one for the life of the process.
KIRI_API_KEY=
KIRI_API_BASE=https://api.kiriengine.app/api/v1/open

# ── Phase 2+, listed so the shape is known ───────────────────────────────────
# AES-256-GCM master key for BYOK reconstruction credentials (KIRI API keys).
RECONSTRUCTION_KEY_SECRET=
KIRI_WEBHOOK_SECRET=
# Renderer kill switch: `spark` (SPZ-capable) or `gs3d` (PLY only, legacy).
NEXT_PUBLIC_SPLAT_RENDERER=spark

# ── Live reconstruction ──────────────────────────────────────────────────────
# The live capture server's phone socket. The laptop's browser connects here
# DIRECTLY (frame bytes never pass through Next), so a browser mixed-content
# rule applies: an https page cannot open a ws:// URL. Open the laptop view on
# http://localhost while the phone uses the tunnel, or serve the studio over TLS.
#   python -m tools.live_capture_server.server --port 8765
NEXT_PUBLIC_LIVE_CAPTURE_WS=ws://localhost:8765/ws/phone

# Scoped to web/ so the repo root's .gitignore stays about the iOS app and the
# Python tools. Paths here are relative to this directory.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build

# testing
/coverage

# Videos handed over for splat reconstruction (POST /api/splat/jobs). Large,
# and not ours to keep — see lib/splatJobs.ts for the handoff.
/.uploads/

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...and we do opt in for the template, which holds no values — only the names,
# and the reasoning about which of them may carry the NEXT_PUBLIC_ prefix.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Figma Make export, kept locally as a design reference. It is a separate Vite app
# with its own lockfile and AGENTS.md; the design it produced lives in this repo as
# app/globals.css tokens plus components/shell and components/trip.
/Journey Moment Capture App/

# bake-routes.mjs Overpass cache — 5 MB of raw OSM pulls, refetched on demand
scripts/.bake-cache/

# Local dev server output (see the session that added ffmpeg-based remuxing).
.devserver.log

# Durable sidecars for the in-process stores (lib/persist.ts). Records of one
# machine's activity, like /.uploads — not source, and not ours to keep.
/.data/

# Posed captures delivered by the WebXR path (POST /api/capture/posed). Frames
# plus a COLMAP model per session — one machine's recordings, like /.uploads/.
# The studio reconstructs them in place; see app/api/capture/posed.
/.captures/
